# Generated atlases and local art: mixed rights / personal sources.
# Keep the explanatory source README and third-party license, not the images.
/docs/screenshots/
/assets/generated/
/assets/source/*
!/assets/source/README.md
/assets/portraits/*
!/assets/portraits/LICENSE-CC-BY-4.0.txt

# Personal saves, positions, exported games, emulated SD cards
/profiles/
/saves/
/save/
/sdmc/
*.dat
*.dat.*
*.fen
*.pgn

# Python and local tooling / SDKs (never vendor an installed toolchain)
/.venv/
/venv/
/devkitPro/
/devkitARM/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
/CMakeFiles/
/CMakeCache.txt
/cmake-build-*/
/compile_commands.json

# Logs, temporary files, secrets and machine-specific editor state
*.log
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
/.idea/
/.vscode/

